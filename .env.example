# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# HMAC pepper for session, token and invite verifiers. Generate with: openssl rand -base64 32
LATTICE_SECRET_PEPPER=

# AI answers (optional). The operator's approved OpenAI-compatible providers, as a JSON array.
# Owners and admins pick one of these per workspace and enter their own key; they never enter a URL.
# LATTICE_AI_PROVIDERS=[{"id":"openai","label":"OpenAI","base_url":"https://api.openai.com/v1","auth":"bearer","models":[{"id":"gpt-4.1-mini","label":"GPT-4.1 mini","context_tokens":128000,"max_output_tokens":800}]}]

# Master keys that encrypt workspace AI keys at rest, as a JSON array of base64 32-byte keys,
# newest first. Required when LATTICE_AI_PROVIDERS is set. Generate with: openssl rand -base64 32
# To rotate: put a new key first, have each workspace re-save its key, then remove the old one.
# LATTICE_AI_KEY_ENCRYPTION_KEYS=["<base64 key>"]
